# ---------------------------------------------------------------------------
# Salud Vida y Bienestar — variables de entorno
# Copia este archivo a `.env` (o `.env.local`) y completa los valores reales.
# NUNCA subas `.env` al repositorio ni expongas secretos con NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------

# --- Aplicación ---
NEXT_PUBLIC_SITE_URL=https://saludvidabienestar.com

# --- Base de datos (PostgreSQL) ---
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE?schema=public
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/svb?schema=public"
# Opcional: conexión directa para migraciones cuando uses un pooler.
# DIRECT_DATABASE_URL=

# --- Autenticación ---
# Secreto de sesión (mínimo 32 bytes). Genéralo con: openssl rand -base64 32
AUTH_SECRET=

# --- Primer administrador (solo para el seed; no se versiona) ---
# El seed crea el administrador únicamente si defines ambos valores.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Mercado Pago (solo servidor, salvo la llave pública) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ENV=sandbox

# --- Cloudinary (opcional) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp está configurado directamente en `src/lib/config.ts`.
